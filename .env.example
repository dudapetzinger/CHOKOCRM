# Variáveis de ambiente do ambiente de desenvolvimento (Docker Compose).
#
# O usuário, a senha e o nome do banco do serviço `db` já estão fixos em
# docker-compose.yml (chokocrm / chokocrm / chokocrm) — este arquivo serve
# apenas como referência das strings de conexão resultantes.

# String de conexão do PostgreSQL vista do host (fora dos containers),
# usada quando a API roda localmente com `npm run dev` (fora do compose).
DATABASE_URL=postgresql://chokocrm:chokocrm@localhost:5432/chokocrm

# Dentro da rede do compose (serviço `api`), o host do banco é o nome do
# serviço, não `localhost`:
# DATABASE_URL=postgresql://chokocrm:chokocrm@db:5432/chokocrm
