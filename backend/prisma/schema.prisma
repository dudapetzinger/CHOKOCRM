generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REPRESENTANTE
  GESTOR
}

enum ResultadoVisita {
  VENDA
  NEGOCIACAO
  SEM_VENDA
}

enum TipoCampanha {
  CAMPANHA
  PROMOCAO
  EVENTO
}

/// Periodicidade da meta (spec 7.8): semana de segunda a domingo, mês do
/// primeiro ao último dia, período livre ou dentro do período da campanha.
enum PeriodoMeta {
  SEMANAL
  MENSAL
  PERSONALIZADO
  CAMPANHA
}

enum EventoSazonal {
  PASCOA
  DIA_DAS_MAES
  NAMORADOS
  DIA_DOS_PAIS
  NATAL
}

model User {
  id                  String                @id @default(uuid())
  nome                String
  /// Sempre em minúsculas (gravado e comparado assim).
  email               String                @unique
  senhaHash           String                @map("senha_hash")
  role                Role
  ativo               Boolean               @default(true)
  telefone            String?
  criadoEm            DateTime              @default(now()) @map("criado_em")
  visits              Visit[]
  scheduleChanges     VisitScheduleChange[]
  stockMessages       StockMessage[]
  clients             Client[]
  passwordResetTokens PasswordResetToken[]
  metas               Goal[]

  @@map("users")
}

/// Link de redefinição de senha: o banco guarda só o hash SHA-256 do token.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Client {
  id                String                @id @default(uuid())
  razaoSocial       String                @map("razao_social")
  nomeFantasia      String                @map("nome_fantasia")
  cnpj              String                @unique
  cidade            String
  endereco          String
  telefone          String
  email             String
  erpId             String?               @map("erp_id")
  recorrenciaDias   Int                   @default(15) @map("recorrencia_dias")
  /// Data prevista da próxima visita, marcada no check-in (spec 7.4). Nula:
  /// a agenda usa a última visita (ou o cadastro) + a recorrência.
  proximaVisita     DateTime?             @map("proxima_visita") @db.Date
  /// Anotação que acompanha a próxima visita (até 200 caracteres).
  lembrete          String?
  /// Campanha da próxima visita (spec 7.7): gravada e apagada com a data a
  /// cada check-in. Excluir a campanha só desvincula.
  proximaCampanhaId String?               @map("proxima_campanha_id")
  proximaCampanha   Campaign?             @relation(fields: [proximaCampanhaId], references: [id], onDelete: SetNull)
  ativo             Boolean               @default(true)
  criadoEm          DateTime              @default(now()) @map("criado_em")
  representanteId   String                @map("representante_id")
  representante     User                  @relation(fields: [representanteId], references: [id])
  contacts          Contact[]
  visits            Visit[]
  scheduleChanges   VisitScheduleChange[]
  stockMessages     StockMessage[]

  @@index([representanteId])
  @@map("clients")
}

model Contact {
  id        String  @id @default(uuid())
  clientId  String  @map("client_id")
  client    Client  @relation(fields: [clientId], references: [id])
  nome      String
  cargo     String
  telefone  String
  email     String
  principal Boolean @default(false)
  visits    Visit[]

  @@map("contacts")
}

model Visit {
  id         String          @id @default(uuid())
  clientId   String          @map("client_id")
  client     Client          @relation(fields: [clientId], references: [id])
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id])
  contactId  String?         @map("contact_id")
  contact    Contact?        @relation(fields: [contactId], references: [id])
  dataHora   DateTime        @map("data_hora")
  descricao  String
  resultado  ResultadoVisita
  fotoPath   String?         @map("foto_path")
  criadoEm   DateTime        @default(now()) @map("criado_em")
  editadoEm  DateTime?       @map("editado_em")
  /// Campanha da visita (spec 7.7). Excluir a campanha só desvincula.
  campanhaId String?         @map("campanha_id")
  campanha   Campaign?       @relation(fields: [campanhaId], references: [id], onDelete: SetNull)
  itens      VisitItem[]

  @@index([clientId, dataHora(sort: Desc)])
  @@index([campanhaId])
  @@map("visits")
}

/// Item do pedido registrado no check-in com resultado VENDA. Nome e preço
/// são copiados do catálogo do ERP no momento do check-in: o pedido não muda
/// se o catálogo mudar depois.
model VisitItem {
  id            String  @id @default(uuid())
  visitId       String  @map("visit_id")
  visit         Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  sku           String
  produtoNome   String  @map("produto_nome")
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  @@index([visitId])
  @@map("visit_items")
}

model VisitScheduleChange {
  id                  String   @id @default(uuid())
  clientId            String   @map("client_id")
  client              Client   @relation(fields: [clientId], references: [id])
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id])
  recorrenciaAnterior Int      @map("recorrencia_anterior")
  recorrenciaNova     Int      @map("recorrencia_nova")
  justificativa       String
  data                DateTime

  @@map("visit_schedule_changes")
}

model StockMessage {
  id              String         @id @default(uuid())
  clientId        String         @map("client_id")
  client          Client         @relation(fields: [clientId], references: [id])
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id])
  eventoSazonalId String?        @map("evento_sazonal")
  eventoSazonal   SeasonalEvent? @relation(fields: [eventoSazonalId], references: [id])
  textoFinal      String         @map("texto_final")
  dataGeracao     DateTime       @map("data_geracao")

  @@map("stock_messages")
}

model SeasonalEvent {
  id                String         @id @default(uuid())
  nome              String         @unique
  chave             EventoSazonal
  dataInicio        DateTime       @map("data_inicio") @db.Date
  dataFim           DateTime       @map("data_fim") @db.Date
  produtosSugeridos String[]       @map("produtos_sugeridos")
  stockMessages     StockMessage[]

  @@map("seasonal_events")
}

/// Campanha, promoção ou evento comercial (spec 7.7), criado pelo gestor.
/// `inicio` e `fim` são dias de calendário, os dois inclusivos (o status é
/// calculado em `campaign.regras.ts`, nunca gravado). `desconto` em % (0–100)
/// e `produtos` com os SKUs do catálogo do ERP em destaque.
model Campaign {
  id                    String       @id @default(uuid())
  nome                  String
  tipo                  TipoCampanha
  inicio                DateTime     @db.Date
  fim                   DateTime     @db.Date
  descricao             String       @default("")
  desconto              Int?
  produtos              String[]
  criadoEm              DateTime     @default(now()) @map("criado_em")
  visits                Visit[]
  clientesProximaVisita Client[]
  metas                 Goal[]

  @@index([inicio])
  @@map("campaigns")
}

/// Meta de visitas e vendas de um representante (spec 7.8), sem campanha ou
/// de uma campanha (excluir a campanha apaga as metas dela). O realizado é
/// calculado a cada leitura, das visitas do representante no período.
model Goal {
  id              String      @id @default(uuid())
  representanteId String      @map("representante_id")
  representante   User        @relation(fields: [representanteId], references: [id])
  periodo         PeriodoMeta
  inicio          DateTime    @db.Date
  fim             DateTime    @db.Date
  metaVisitas     Int         @map("meta_visitas")
  metaVendas      Decimal     @map("meta_vendas") @db.Decimal(12, 2)
  campanhaId      String?     @map("campanha_id")
  campanha        Campaign?   @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  criadoEm        DateTime    @default(now()) @map("criado_em")

  @@index([representanteId])
  @@index([campanhaId])
  @@map("goals")
}
