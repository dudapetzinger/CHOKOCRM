FROM node:22-alpine

WORKDIR /app

# O schema e a configuração do Prisma precisam existir antes do `npm ci`,
# porque a instalação dispara `prisma generate` (script postinstall).
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma

# Valor de marcação usado apenas durante o build: `prisma generate` exige uma
# URL sintaticamente válida, mas não abre conexão. Em execução, o docker-compose
# sobrescreve esta variável com a string de conexão real do serviço `db`.
ENV DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

RUN npm ci

COPY . .

CMD ["npm", "run", "dev"]
