# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3000

# String de conexão do PostgreSQL (serviço `db` do docker-compose.yml,
# raiz do repositório). Ao rodar a API localmente com `npm run dev`
# (fora do compose), use `localhost` como host, como abaixo.
DATABASE_URL=postgresql://chokocrm:chokocrm@localhost:5432/chokocrm

# Segredo usado para assinar/verificar os tokens JWT de autenticação.
# Gerar um valor forte e exclusivo por ambiente (nunca reutilizar este exemplo).
JWT_SECRET=troque-por-um-segredo-aleatorio-forte

# Tempo de expiração do token JWT (formato aceito pela lib jsonwebtoken).
JWT_EXPIRES_IN=8h

# Origem do frontend (dev server do Vite), liberada via CORS.
FRONTEND_URL=http://localhost:5173

# Diretório onde as fotos de comprovação de check-in são gravadas.
# Caminho relativo é resolvido a partir da raiz do backend. Em produção
# (Etapa 6) aponta para o diretório persistente do App Service ou é
# substituído pelo driver de Azure Blob Storage.
UPLOADS_DIR=./uploads

# Liga/desliga o job diário que calcula a agenda de cada representante e
# registra um log estruturado por representante (alertas de atraso/hoje).
# Desativado no CI (não há necessidade de agendamento em pipeline).
AGENDA_JOB_ENABLED=true

# Expressão cron (formato node-cron, 5 campos) de quando o job roda,
# interpretada no fuso do representante (America/Sao_Paulo). Padrão: 6h da manhã.
AGENDA_JOB_CRON=0 6 * * *

# Provedor de ERP em uso (Etapa 5). Só existe `mock` por ora — um adapter
# real seria adicionado como outra opção, sem alterar services/controllers.
ERP_PROVIDER=mock

# Força o `MockErpProvider` a responder "indisponível" (rejeita com
# ErpIndisponivelError), para demonstrar o fluxo de exceção da ficha do
# cliente (UC11 E3).
ERP_MOCK_FALHAR=false

# Connection string do Azure Application Insights (telemetria de requisições,
# dependências e exceções). Vazia = telemetria desligada (padrão em
# desenvolvimento, testes e CI).
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Produção (Azure App Service) ---
# Configurações do App Service (Settings > Environment variables). Valores
# fictícios de exemplo — os reais são gerados/preenchidos pelo scripts/wizard-azure.sh
# e nunca vão para o repositório. A PORT é injetada pelo próprio App Service.
# NODE_ENV=production
# DATABASE_URL=postgresql://usuario:senha@meu-servidor.postgres.database.azure.com:5432/chokocrm?sslmode=require
# JWT_SECRET=<48 bytes aleatórios em base64, gerados pelo wizard>
# JWT_EXPIRES_IN=8h
# FRONTEND_URL=https://exemplo-swa.azurestaticapps.net
# UPLOADS_DIR=/home/uploads
# AGENDA_JOB_ENABLED=true
# AGENDA_JOB_CRON=0 6 * * *
# ERP_PROVIDER=mock
# ERP_MOCK_FALHAR=false
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://exemplo.in.applicationinsights.azure.com/
# SCM_DO_BUILD_DURING_DEPLOYMENT=false
# WEBSITE_RUN_FROM_PACKAGE=0
